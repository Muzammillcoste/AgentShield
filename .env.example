# AgentShield environment template. Copy to `.env` (never commit `.env`).
# Values here are placeholders; no model availability or pricing is implied.

# `fake` runs fully offline (tests, CI, smoke runs). Fake-model output is never research evidence.
# `openai_compatible` uses a real chat-completions endpoint with native tool calling (Phase 2).
MODEL_PROVIDER=fake

# Exact model identifier, e.g. as listed by your provider's /models endpoint. Must be explicit.
AGENTSHIELD_MODEL=

# API key for the real provider. Never paste keys into chat, logs, configs, or git.
LLM_API_KEY=

# Base URL of an OpenAI-compatible chat-completions API (provider specific).
LLM_BASE_URL=
